####### Install

install_target: first FORCE
	@if not exist D:$(INSTALL_ROOT:@msyshack@%=%)\software\Qt5.12.10\Examples\Qt-5.12.10\serialbus\modbus\master mkdir D:$(INSTALL_ROOT:@msyshack@%=%)\software\Qt5.12.10\Examples\Qt-5.12.10\serialbus\modbus\master & if not exist D:$(INSTALL_ROOT:@msyshack@%=%)\software\Qt5.12.10\Examples\Qt-5.12.10\serialbus\modbus\master exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) D:$(INSTALL_ROOT:@msyshack@%=%)\software\Qt5.12.10\Examples\Qt-5.12.10\serialbus\modbus\master\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) D:$(INSTALL_ROOT:@msyshack@%=%)\software\Qt5.12.10\Examples\Qt-5.12.10\serialbus\modbus\master\$(TARGET)
	-$(DEL_DIR) D:$(INSTALL_ROOT:@msyshack@%=%)\software\Qt5.12.10\Examples\Qt-5.12.10\serialbus\modbus\master 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

